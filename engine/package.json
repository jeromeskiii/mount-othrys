{
  "name": "@mount-othrys/engine",
  "version": "0.1.0",
  "description": "Mount Othrys Engine — AI Mode-Orchestration System (Planner + Executor Framework)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mount-othrys": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "mount-othrys",
    "titan",
    "ai-agents",
    "orchestration"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
