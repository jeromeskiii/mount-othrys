{
  "name": "@mount-othrys/heracles",
  "version": "1.0.0",
  "description": "Heracles - High-Intensity Work Mode for Kronos Titan Intelligence",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc --emitDeclarationOnly",
